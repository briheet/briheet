---
import { getCollection, render } from "astro:content";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import Layout from "../../layouts/Layout.astro";

const [workex] = await getCollection("workex");

const { Content } = await render(workex);
---

<Layout
  title="Work Experience | Briheet Singh Yadav"
  description="Work experience of Briheet Singh Yadav, a software engineer working on systems, infrastructure, AI inference and low-latency backends in Rust and Go."
>
  <div class="min-h-screen">
    <Nav />

    <main class="mx-auto mt-0 max-w-5xl px-6">
      <h1 class="sr-only">Work experience of Briheet Singh Yadav</h1>
      <article class="blog-content max-w-none text-base leading-7 text-zinc-300">
        <Content />
      </article>
    </main>

    <Footer />
  </div>
</Layout>
